# Emissions accounting backend environment
NODE_ENV=production
PORT=3000

# PostgreSQL 16 (docker compose service `db`)
DATABASE_URL=postgres://ghg:ghg@db:5432/ghg
PG_POOL_MAX=10

# Determinism: emitted numbers are exact rational decimals.
# Decimal digits kept when an internal fraction is not terminating (GWP ratios are terminating,
# so this is a defensive ceiling only).
EMISSION_DECIMAL_PLACES=12
